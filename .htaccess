
# av:php5-engine
AddHandler av-php56 .php

# ── Clean URLs per le pagine pubbliche ────────────────────────────────────
# Mappa gli URL senza estensione ai file PHP in /public/.
# Ogni RewriteRule è indipendente: aggiungere nuove pagine segue lo stesso schema.

RewriteEngine On

# /il-gioco  → /public/il-gioco.php
RewriteRule ^il-gioco$  /public/il-gioco.php  [L,QSA]

# /ambientazione → /public/ambientazione.php
RewriteRule ^ambientazione$  /public/ambientazione.php  [L,QSA]

# /razze → /public/razze.php
RewriteRule ^razze$  /public/razze.php  [L,QSA]

# /come-si-gioca → /public/come-si-gioca.php
RewriteRule ^come-si-gioca$  /public/come-si-gioca.php  [L,QSA]

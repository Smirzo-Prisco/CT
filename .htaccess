# av:php5-engine
AddHandler av-php56 .php

# ── Clean URLs per le pagine pubbliche ────────────────────────────────────
# Options +FollowSymLinks è richiesto da Apache per abilitare RewriteEngine
# in .htaccess. Senza questa riga RewriteEngine viene ignorato silenziosamente.

Options +FollowSymLinks
RewriteEngine On
RewriteBase /

# Non toccare file e directory che esistono già (CSS, JS, immagini, ecc.)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# /il-gioco, /ambientazione, /razze, /come-si-gioca → file in /public/
RewriteRule ^(il-gioco|ambientazione|razze|come-si-gioca)$ /public/$1.php [L]
